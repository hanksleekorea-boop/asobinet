>>>>>>         subdirs, one_dir, one_file = itertools.tee(children, 3)
       
>>>>>>         try:
>>>>>>             return only(one_dir)
>>>>>>         except ValueError:
>>>>>>             try:
>>>>>>                 return cls(*subdirs)
>>>>>>             except NotADirectoryError:
>>>>>>                 return next(one_file)
       
